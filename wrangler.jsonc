{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "dpedro-solucoes-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}